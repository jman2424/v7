# Export these variables through your service environment.
# This file contains no usable credentials.
MODE=V7
BUSINESS_KEY=TARIQ
PORT=10000
BASE_URL=http://127.0.0.1:10000
SECRET_KEY=
LOG_LEVEL=info

# Provision with scripts/manage_account.py; use an absolute protected path.
ADMIN_USERS_FILE=
SECURITY_DB_PATH=logs/security.db
ANALYTICS_DB_PATH=logs/analytics.db

# Keep one worker while conversation memory is process-local.
WEB_CONCURRENCY=1
WEB_THREADS=2
FORWARDED_ALLOW_IPS=127.0.0.1,::1
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=60

# AI provider (optional for isolated local preview).
OPENAI_API_KEY=

# Optional Meta WhatsApp. Leave blank until connecting the assigned company.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# Optional Twilio WhatsApp alternative.
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Optional signed catalog integration and Sheets credentials.
CATALOG_WEBHOOK_SECRET=
SHEETS_SERVICE_JSON=
