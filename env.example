# Core Mode
BUSINESS_KEY=EXAMPLE

# Optional AI provider. Business setup, widget preview, and model choices work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=30
# Optional server transcription for widget recordings and WhatsApp voice notes.
V7_TRANSCRIPTION_MODEL=gpt-transcribe

# Prepaid AI usage is separate from monthly subscriptions; no included credit.
# 0% is the default. Change only to an agreed, disclosed customer markup.
V7_USAGE_MARKUP_PERCENT=0
V7_USAGE_LOW_BALANCE_PENCE=200
# Optional model pricing overrides: integer USD nanodollars per token.
# Example: {"gpt-4o-mini":{"input":150,"cached":75,"output":600}}
# Configure actual dated model IDs too when overriding alias prices.
V7_MODEL_PRICING_JSON=
# Optional transcription pricing: nanodollars per second or input/output token.
V7_AUDIO_PRICING_JSON=
# Optional operator USD/GBP reference; both settings required. References older
# than four days pause chargeable requests. Blank uses the existing ECB source.
V7_USAGE_USD_GBP_RATE=
V7_USAGE_RATE_DATE=

# Server
PORT=10000
SECRET_KEY=
# Required: generate a random value of at least 32 characters before starting.
BASE_URL=http://127.0.0.1:10000
# After configuring the official custom domain, block all default Render routes.
# Keep true only when intentionally using the onrender.com address.
V7_ALLOW_RENDER_SUBDOMAIN=false
ENVIRONMENT=development
LOG_LEVEL=info
# Browser login expires after at most eight hours. A trusted device is separate
# and only skips routine MFA after a fresh password or linked OAuth check.
SESSION_MAX_AGE_SECONDS=28800
# Optional Google and Microsoft sign-in for accounts explicitly linked in V7.
# Register https://YOUR_BASE_URL/auth/oidc/google/callback and
# https://YOUR_BASE_URL/auth/oidc/microsoft/callback with each provider.
# OAuth client secrets stay server-side and must never be exposed to the widget.
V7_GOOGLE_CLIENT_ID=
V7_GOOGLE_CLIENT_SECRET=
V7_MICROSOFT_CLIENT_ID=
V7_MICROSOFT_CLIENT_SECRET=
V7_MICROSOFT_TENANT=common

# Storage: sqlite/files is the default. Preserve and verify the complete live
# export before switching an existing deployment; see docs/SUPABASE_MIGRATION.md.
V7_STORAGE_BACKEND=sqlite
V7_DATA_DIR=
ANALYTICS_DB_PATH=logs/analytics.db
CRM_SNAPSHOT_PATH=
# PostgreSQL: restricted server login inheriting only v7_backend, never migration owner.
# Connections enforce verify-full TLS. Keep the DSN server-only.
V7_POSTGRES_DSN=
V7_SUPABASE_CA_FILE=
# Import-only credential; do not use this for application requests.
V7_SUPABASE_MIGRATION_DSN=

# WhatsApp
# auto preserves existing providers. Explicit modes: meta, twilio, both.
WHATSAPP_PROVIDER_MODE=auto
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Optional for multiple businesses on one WhatsApp Cloud app. Keep this mapping server-only.
# WHATSAPP_TENANT_MAP_JSON={"123456789012345":"EXAMPLE","987654321098765":"NORTHSTAR"}
# Optional provider-specific maps take priority over the legacy shared map.
# An explicit {} disables recipient assignments for that provider; blank preserves legacy routing.
# WHATSAPP_META_TENANT_MAP_JSON={"123456789012345":"EXAMPLE"}
# TWILIO_WHATSAPP_TENANT_MAP_JSON={"whatsapp:+447700900999":"EXAMPLE"}
# Required in production when accepting Twilio WhatsApp webhooks.
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Optional for inbound voice media. API key credentials are preferred; if absent,
# V7 uses the signed webhook's AccountSid with TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Billing
BILLING_PROVIDER=stripe
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_BASE=https://api.stripe.com
# Existing Stripe Tax Rate ID: active, 20%, exclusive (not inclusive).
STRIPE_TAX_RATE_ID=
# Set true only after HMRC confirms VAT registration is effective.
V7_VAT_REGISTERED=false
# Use durable SQLite/file storage or a verified PostgreSQL cutover before live billing.

# Admin Auth
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Prefer scripts/manage_account.py and a protected registry outside business/.
ADMIN_USERS_FILE=
# Defaults to <V7_DATA_DIR>/logs/security.db, or logs/security.db without a data directory.
# SECURITY_DB_PATH=
# New/reset managed passwords use scrypt; existing bcrypt hashes remain supported.
# Never store plaintext passwords in tenant account definitions.
# BUSINESS_USERS_JSON=[{"email":"owner@example.com","tenant":"EXAMPLE","password_hash":"$2b$...","roles":["business_owner"]}]

# Optional Integrations
# Public signup requires all four settings and a verified provider sender domain.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend, SMTP_PASSWORD=API key.
# V7 then uses Resend HTTPS; SMTP port/TLS-mode settings do not apply to that path.
# Resend MCP authorization does not configure these runtime secrets.
# Do not use onboarding@resend.dev for public signup.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_PORT=587

# Optional owner OAuth for MCP and REST; HTTPS origin must match BASE_URL.
MCP_PUBLIC_URL=
MCP_OAUTH_CLIENTS={}
MCP_ALLOWED_ORIGINS=

# Optional platform privacy notice details. Blank values remain clearly marked drafts.
# Business notices use their own owner-managed privacy settings, not these defaults.
# Retention settings describe the policy; they do not schedule or delete records.
V7_PRIVACY_CONTROLLER=
V7_PRIVACY_CONTACT_EMAIL=
V7_PRIVACY_RETENTION_DAYS=
V7_PRIVACY_RETENTION_CRITERIA=
V7_PRIVACY_LAWFUL_BASIS=

# Optional public marketing analytics. Leave empty to disable.
# Set the GA4 web-stream measurement ID only, for example G-XXXXXXXXXX.
# This is a public identifier, never an API key. Analytics requires separate opt-in.
GA4_MEASUREMENT_ID=

# Optional assistant on the public homepage, about, setup guide and solution pages.
# Leave empty to disable. Configure and activate this tenant through the workspace
# first, including its business knowledge and approved website origins.
PUBLIC_WIDGET_TENANT=

# Optional fee exemption for one existing platform-owned first-party marketing tenant.
# Exact case-sensitive key only. It must have been created by a platform admin
# with no business-owner assignment. Default empty keeps verified-payment checks.
# This does not grant a user role, change an invoice or exempt API provider costs.
# Set only after approving ongoing public chat access for this internal business.
PLATFORM_MARKETING_TENANT=
# Optional business email/phone handlers. Leave off until the private operations
# migration and provider routing/signature checks have been verified.
V7_CHANNEL_WORKER=false
V7_CHANNEL_RESEND_API_KEY=
V7_EMAIL_WEBHOOK_SECRET=
V7_EMAIL_ROUTES_JSON={}
V7_EMAIL_SENDERS_JSON={}
V7_AGENT_MODULE_POLICY_JSON={}
V7_EMAIL_INBOX_ROUTES_JSON={}
# Per-tenant email campaign binding. Each tenant key maps to exactly: segment_id,
# sender, business_name, mailing_address and a dedicated provider api_key (secret).
V7_EMAIL_CAMPAIGN_ROUTES_JSON=
V7_PHONE_AUTH_TOKEN=
V7_PHONE_ACCOUNT_SID=
V7_PHONE_ROUTES_JSON={}

# ---------------------------------------------------------------------------
# Storage locations (SQLite/file backend). See service/runtime_paths.py.
# Every path defaults to <V7_DATA_DIR>/logs/<name>, or logs/<name> when no data
# directory is set. Set these only to place a file somewhere else.
# ---------------------------------------------------------------------------
# ANALYTICS_DB_PATH=
# CRM_SNAPSHOT_PATH=
# AUDIT_LOG_PATH=
# LOG_DIR=
# Overrides only where tenant business documents live (default <V7_DATA_DIR>/business).
# BUSINESS_DATA_ROOT=

# ---------------------------------------------------------------------------
# Web server (gunicorn.conf.py)
# ---------------------------------------------------------------------------
# Keep one worker: conversation memory and rate limits are held in process memory.
WEB_CONCURRENCY=1
WEB_THREADS=2
WEB_TIMEOUT=90
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=5
# BIND=0.0.0.0:10000
# Proxies whose X-Forwarded-* headers gunicorn accepts.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Number of trusted reverse proxies in front of the app (1 on Render, else 0).
# TRUST_PROXY_COUNT=0

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=60
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Background workers (each is off unless set to true)
# ---------------------------------------------------------------------------
# V7_APPLICATION_WORKER=false
# V7_AI_BUDGET_WORKER=false
# Keeps connected data sources (WooCommerce, Shopify, custom feeds) up to date.
# Defaults to V7_CHANNEL_WORKER. Apply the business_sync migration first.
# V7_SYNC_WORKER=false
# Encrypts stored data-source credentials (32+ characters). Defaults to a key
# derived from SECRET_KEY; set it so rotating SECRET_KEY does not disconnect sources.
# V7_SYNC_ENCRYPTION_KEY=
# Shopify Admin API version used for product synchronisation.
# V7_SHOPIFY_API_VERSION=2026-07
# Sends telemetry off the request thread (default true on Render).
# V7_ASYNC_TELEMETRY=false
# Pooled PostgreSQL connections (default true on Render).
# V7_POSTGRES_POOL_ENABLED=false

# ---------------------------------------------------------------------------
# AI budget and provider cost monitoring
# ---------------------------------------------------------------------------
# Real automatic card recharges stay disabled unless this is exactly true.
# V7_AUTO_RECHARGE_LIVE_ENABLED=false
# Reads official provider costs; requires an OpenAI organisation admin key.
# V7_PROVIDER_COST_MONITOR=false
# OPENAI_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Other optional settings
# ---------------------------------------------------------------------------
# Signs POST /catalog_webhook imports into the default BUSINESS_KEY tenant only.
# CATALOG_WEBHOOK_SECRET=
# Monitored reply address for account emails.
# SMTP_REPLY_TO=
# Postal address shown on the public privacy notice.
# V7_PUBLIC_BUSINESS_ADDRESS=
# Port for scripts/run_local.py.
# LOCAL_PREVIEW_PORT=10000
