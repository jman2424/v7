{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_catalog"
  ],
  "properties": {
    "product_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "items"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "price_str"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "price_str": {
                  "type": "string",
                  "minLength": 1
                },
                "stock": {
                  "type": "string"
                },
                "subcategory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
