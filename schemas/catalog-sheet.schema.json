{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_catalog"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "minLength": 1, "maxLength": 64 }] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "product_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "price_str"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "price_str": {
                  "type": "string",
                  "minLength": 1
                },
                "stock": {
                  "type": "string"
                },
                "subcategory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
