{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "industry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "order",
          "booking",
          "job",
          "project",
          "viewing",
          "appointment",
          "ticket"
        ]
      }
    },
    "offerings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "product",
              "service",
              "package",
              "subscription",
              "custom_quote"
            ]
          },
          "price_type": {
            "enum": [
              "fixed",
              "from",
              "per_word",
              "per_hour",
              "per_unit",
              "quote"
            ]
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 525600
          },
          "active": {
            "type": "boolean"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "price_type",
          "active"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "price_type": {
                  "enum": [
                    "fixed",
                    "from"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "price"
              ]
            }
          }
        ]
      }
    },
    "locations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "store",
              "office",
              "workshop",
              "warehouse",
              "mobile_service_area",
              "remote_only"
            ]
          },
          "address": {
            "type": "string",
            "maxLength": 500
          },
          "service_area": {
            "type": "string",
            "maxLength": 500
          },
          "radius_miles": {
            "type": "number",
            "minimum": 0,
            "maximum": 25000
          },
          "hours": {
            "type": "object",
            "maxProperties": 14,
            "additionalProperties": {
              "type": "string",
              "maxLength": 100
            }
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "active"
        ],
        "additionalProperties": false
      }
    },
    "business_rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "active": {
            "type": "boolean"
          },
          "requires_manual_review": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "active"
        ],
        "additionalProperties": false
      }
    },
    "work": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "order",
              "booking",
              "job",
              "project",
              "viewing",
              "appointment",
              "ticket"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "offering_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "customer_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "offerings",
    "locations",
    "business_rules",
    "work"
  ],
  "additionalProperties": false
}
